# copie para .env e preencha a chave
LLM_MODEL=gemini/gemini-3.5-flash
LLM_API_KEY=
# Reservas (opcionais), usadas nesta ordem se o modelo principal falhar:
# 1) outro modelo Gemini, com a mesma chave
LLM_RESERVA_MODEL=gemini/gemini-3.5-flash-lite
# 2) Groq, com chave própria (console.groq.com); recebe dados resumidos por causa do limite gratuito
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true

# trello opcional
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_WORKSPACE_ID=
